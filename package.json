{
  "name": "cyclo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11.0.0 <12"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:db": "npx --yes supabase@3.2.0 test db",
    "test:integration": "node --env-file=.env.supabase-local --test tests/integration/*.local.mjs",
    "db:types": "node scripts/gen-db-types.mjs",
    "db:seed:local": "node --env-file=.env.supabase-local scripts/seed-local-employees.mjs",
    "dev:local": "node --env-file=.env.supabase-local scripts/dev-local.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.0",
    "clsx": "2.1.1",
    "lucide-react": "1.74.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3"
  }
}
